# 知己服务器环境变量（明文，放在服务器上，权限 0600、属主 root）
# 用法：放到 /etc/zhiji/zhiji.env，然后由 systemd 的 EnvironmentFile= 读取。
#   sudo install -d -m 0700 /etc/zhiji
#   sudo install -m 0600 /dev/null /etc/zhiji/zhiji.env   # 或直接编辑下面内容
#   sudo chmod 600 /etc/zhiji/zhiji.env
# 这个文件不要放进 Git、不要拷回本地仓库。

# 数据库与来源（按你的实际路径与域名修改）
ZHIJI_DATABASE_PATH=/opt/zhiji/backend/data/zhiji.sqlite3
ZHIJI_KNOWLEDGE_DATABASE_PATH=/opt/zhiji/backend/data/zhiji.knowledge.sqlite3
ZHIJI_COOKIE_SECURE=true
ZHIJI_ALLOWED_ORIGINS=https://your-domain.cn,capacitor://localhost

# 启用模型解释
ZHIJI_LLM_ENABLED=true
ZHIJI_LLM_BASE_URL=https://api.deepseek.com
ZHIJI_LLM_MODEL=deepseek-v4-flash

# 把下面这一行的值替换成真实密钥后再保存（明文，仅本文件、仅服务器）
DEEPSEEK_API_KEY=
