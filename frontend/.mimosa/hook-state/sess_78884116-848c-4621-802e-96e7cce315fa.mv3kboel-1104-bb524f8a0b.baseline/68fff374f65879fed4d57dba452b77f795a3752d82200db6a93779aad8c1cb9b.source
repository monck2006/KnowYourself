.report-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
.report-questions-input { margin: 0; }
.report-modal { width: min(960px, 100%); max-width: 960px; }
.visit-report { background: #fff; color: #23342b; padding: 28px; border: 1px solid #dde5dc; border-radius: 12px; font: 14px/1.7 -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif; overflow-wrap: anywhere; }
.visit-report * { box-sizing: border-box; }
.visit-report h1, .visit-report h2, .visit-report h3, .visit-report h4, .visit-report p, .visit-report dl { margin: 0; }
.visit-report h1 { font-size: 24px; line-height: 1.4; margin: 8px 0 14px; }
.visit-report h2 { font-size: 18px; margin-bottom: 10px; }
.visit-report h3 { font-size: 15px; margin-bottom: 8px; }
.visit-report h4 { font-size: 14px; margin-bottom: 6px; }
.visit-report-header { border-bottom: 2px solid #4a7c5f; padding-bottom: 18px; }
.visit-report-brand { color: #4a7c5f; letter-spacing: 1px; font-size: 12px; }
.visit-report-header > p:last-child { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.visit-report-notice { background: #f3f6f0; padding: 12px 14px; margin: 18px 0 !important; font-size: 12px; }
.visit-report-summary, .visit-report-questions { padding: 8px 0 20px; }
.visit-report-overview { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 14px 0; }
.visit-report-muted { color: #657169; font-size: 12px; margin-top: 12px !important; }
.visit-report-questions p, .visit-report-notes p { white-space: pre-wrap; }
.visit-report-episode { border-top: 1px solid #dce3da; padding: 18px 0; }
.visit-report-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; }
.visit-report-facts dt { color: #657169; font-size: 12px; }
.visit-report-facts dd { margin: 0; }
.visit-report-measurements, .visit-report-medications, .visit-report-notes { margin-top: 14px !important; }
.visit-report table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 13px; }
.visit-report th, .visit-report td { border: 1px solid #dce3da; padding: 8px; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
.visit-report th { background: #f3f6f0; font-weight: 600; }
.visit-report-footer { border-top: 1px solid #dce3da; padding-top: 14px; color: #657169; font-size: 12px; }
@media (max-width: 600px) {
  .visit-report { padding: 18px 14px; }
  .visit-report h1 { font-size: 21px; }
  .visit-report-overview, .visit-report-facts { grid-template-columns: 1fr; }
}
@media print {
  @page { size: A4; margin: 15mm; }
  body:has(.visit-report) { background: #fff !important; overflow: visible !important; height: auto !important; }
  body:has(.visit-report) .app-shell,
  body:has(.visit-report) .toast-message,
  body:has(.visit-report) .modal-header,
  body:has(.visit-report) .report-toolbar { display: none !important; }
  body:has(.visit-report) .modal-backdrop { position: static !important; display: block !important; padding: 0 !important; background: #fff !important; backdrop-filter: none !important; }
  body:has(.visit-report) .modal,
  body:has(.visit-report) .modal-content { display: block !important; width: 100% !important; max-width: none !important; max-height: none !important; height: auto !important; padding: 0 !important; margin: 0 !important; overflow: visible !important; box-shadow: none !important; border: 0 !important; border-radius: 0 !important; animation: none !important; }
  .visit-report { padding: 0; border: 0; border-radius: 0; font-size: 10pt; color: #000; }
  .visit-report h1 { font-size: 18pt; }
  .visit-report h2 { font-size: 13pt; }
  .visit-report h3, .visit-report h4 { break-after: avoid; }
  .visit-report-header, .visit-report-facts, .visit-report-overview { break-inside: avoid; }
  .visit-report-facts, .visit-report-overview { grid-template-columns: 1fr 1fr; }
  .visit-report thead { display: table-header-group; }
  .visit-report tr { break-inside: avoid; }
  .visit-report p { orphans: 3; widows: 3; }
}
