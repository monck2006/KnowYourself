# Environment examples. Set these in the shell; .env is not automatically read.
ZHIJI_DATABASE_PATH=./data/zhiji.sqlite3
ZHIJI_COOKIE_SECURE=false
ZHIJI_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost
# Optional PostgreSQL business storage; takes precedence over ZHIJI_DATABASE_PATH.
# Set secrets only in your deployment environment, never commit a real URL.
# ZHIJI_DATABASE_URL=postgresql://zhiji:<password>@127.0.0.1:5432/zhiji
# Official knowledge remains in its separate SQLite cache, never in personal records.
# ZHIJI_KNOWLEDGE_DATABASE_PATH=./data/knowledge.sqlite3
ZHIJI_OPENFDA_ENABLED=true
# Optional key for a higher openFDA daily quota; never sent to clients.
# OPENFDA_API_KEY=
# Optional, opt-in explanations. Defaults off; .env is not automatically loaded.
ZHIJI_LLM_ENABLED=false
ZHIJI_LLM_BASE_URL=https://api.deepseek.com
ZHIJI_LLM_MODEL=deepseek-v4-flash
# Set either key in the process environment; never in the frontend or Git.
# DEEPSEEK_API_KEY=
# ZHIJI_LLM_API_KEY=
