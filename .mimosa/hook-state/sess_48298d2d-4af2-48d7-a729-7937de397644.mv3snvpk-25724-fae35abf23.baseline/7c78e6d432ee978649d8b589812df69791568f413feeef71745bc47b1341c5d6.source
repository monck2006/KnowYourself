const a={heart_rate:{label:"心率",unit:"bpm",displayUnit:"次/分",min:20,max:250,step:"1"},spo2:{label:"血氧",unit:"%",displayUnit:"%",min:50,max:100,step:".1"},temperature:{label:"体温",unit:"C",displayUnit:"°C",min:30,max:45,step:".1"},steps:{label:"步数",unit:"count",displayUnit:"步",min:0,max:2e5,step:"1"},sleep_minutes:{label:"睡眠时长",unit:"min",displayUnit:"分钟",min:0,max:1440,step:"1"}},n={manual:"手动录入",health_connect:"Android Health Connect",healthkit:"Apple 健康",bluetooth:"蓝牙心率设备"},i={resting:"静息",active:"活动中",unknown:"状态未知"};function s(t,e){if(!Number.isFinite(t)||!Number.isFinite(e)||Math.abs(t)>90||Math.abs(e)>180)throw new Error("定位结果无效，请手动选择地区。");return`grid:${Math.floor(t*10)}:${Math.floor(e*10)}`}export{s as a,i as c,a as m,n as s};
